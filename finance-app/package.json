{
    "name": "finance-app",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "module:0": "node switch-module.js module-0-base",
        "module:1": "node switch-module.js module-1-layout",
        "module:2": "node switch-module.js module-2-dashboard",
        "module:3": "node switch-module.js module-3-transactions",
        "module:4": "node switch-module.js module-4-forms",
        "modules": "node switch-module.js",
        "clean:browser": "node clean-browser.js",
        "clean:all": "rm -rf node_modules/.vite dist && npm cache clean --force",
        "dev:clean": "npm run clean:all && npm run dev",
        "dev:debug": "vite --debug"
    },
    "devDependencies": {
        
        "@types/node": "^25.0.3",
        "autoprefixer": "^10.4.16",
        "babel-plugin-styled-components": "^2.1.4",
        "postcss": "^8.4.31"
        
    },
    "dependencies": {
       
        "@vitejs/plugin-react": "^5.1.2",
        "lucide-react": "^0.562.0"
    }
}
